# Browser-safe (committed to the bundle): URL + publishable key only.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server/CLI only - NEVER prefix with VITE_ and never commit real values.
# Shared pooler (session mode). Password is in Dashboard > Project Settings > Database.
# DATABASE_URL=postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
# SUPABASE_SECRET_KEY=sb_secret_...

# M-Pesa Daraja - server only
MPESA_ENV=sandbox            # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_BASE=https://your-public-domain   # Safaricom POSTs results to <base>/api/mpesa/callback/<secret>
MPESA_CALLBACK_SECRET=change-me
PORT=8787
